[resource]
script = ExtResource("1_s")
client_id = &"pak_rt"
client_name = "Pak RT"
persona = "Bapak-bapak santai"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(0.4, 0.85, 0.75, 1)
request_lines = PackedStringArray("Dik, motor Bapak buat keliling kampung. Tolong ganti {parts} ya. Ini {budget}, santai saja.", "Assalamualaikum Dik. Bapak mau {parts}. Uangnya {budget}, ngopi dulu sambil nunggu.")
twist_lines = PackedStringArray("Waduh Dik, barusan ditelpon Ibu, uang belanja dipakai. Bapak cuma pegang {budget}. {slot}-nya diakali yang penting tetap gagah ya!", "Dik, maaf, iuran kampung belum lunas. Tinggal {budget}. {slot} yang penting kelihatan bagus.")
happy_lines = PackedStringArray("Hahaha mantap Dik! Nanti Bapak umumkan di pengajian!", "Bagus sekali! Kamu memang montir kebanggaan kampung!")
neutral_lines = PackedStringArray("Ya sudah, terima kasih Dik.", "Cukup lah buat ke pasar.")
angry_lines = PackedStringArray("Lho Dik, kok begini? Bapak kecewa sekali.", "Ini nggak bener Dik! Nanti Bapak rapatkan!")
