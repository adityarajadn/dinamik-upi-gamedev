[resource]
script = ExtResource("1_s")
client_id = &"pak_rt"
client_name = "Pak RT"
persona = "Laid-back old man"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(0.4, 0.85, 0.75, 1)
request_lines = PackedStringArray("Son, I ride this bike around the neighborhood. Please replace the {parts}. Here\'s {budget}, no rush.", "Hello there, son. I\'d like {parts}. I\'ve got {budget}, I\'ll have a coffee while I wait.")
twist_lines = PackedStringArray("Oh dear son, the wife just called, she used the grocery money. I only have {budget}. Work some magic on the {slot}, as long as it still looks sharp!", "Sorry son, the neighborhood dues aren\'t paid yet. I\'ve got {budget} left. The {slot} just needs to look nice.")
happy_lines = PackedStringArray("Hahaha great job son! I\'ll tell everyone at the community meeting!", "Excellent! You really are the pride of the neighborhood!")
neutral_lines = PackedStringArray("Alright, thank you son.", "Good enough for trips to the market.")
angry_lines = PackedStringArray("Hey son, why is it like this? I\'m very disappointed.", "This isn\'t right, son! I\'m bringing this up at the meeting!")
