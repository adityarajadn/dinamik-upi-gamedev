[resource]
script = ExtResource("1_s")
client_name = "Doni Skater"
persona = "Eccentric hangout kid"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(1, 0.45, 0.75, 1)
request_lines = PackedStringArray("Yo! My bike\'s gotta be the coolest at the hangout. Swap the {parts}! My budget\'s {budget}.", "Yo, I wanna stand out at the skate jam! Hook me up with {parts}. Got {budget}, no stress.")
twist_lines = PackedStringArray("Ugh man, so sorry! I just spent my cash on a new skateboard. Only {budget} left, but I still want the {slot} to look stylish! What now?!", "Wait wait, hold up! My mom called, I gotta pay rent. I only have {budget} left, but don\'t make the {slot} look tacky!")
happy_lines = PackedStringArray("Insane, my bike\'s the meanest one now! Respect!", "Awesome! Tomorrow I\'m bringing the whole crew here!")
neutral_lines = PackedStringArray("Hmm okay, not bad.", "Fine, good enough for hanging out.")
angry_lines = PackedStringArray("What is this?! It sounds weird and the paint\'s scratched! I\'m putting you on blast!", "Dude, this is total junk!")
