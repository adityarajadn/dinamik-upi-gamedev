[resource]
script = ExtResource("1_s")
client_name = "Doni Skater"
persona = "Anak tongkrongan eksentrik"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(1, 0.45, 0.75, 1)
request_lines = PackedStringArray("Bang! Motor gue harus paling kece di tongkrongan. Ganti {parts} ya! Budget gue {budget}.", "Yo Bang, gue mau tampil beda pas skate jam! Pasangin {parts}. Duit ada {budget}, santuy.")
twist_lines = PackedStringArray("Duh Bang, sorry banget! Barusan duit gue kepake beli papan skate baru. Sisa {budget} doang, tapi {slot} pengen tetep keliatan gaya! Gimana dong?!", "Bang bang, stop dulu! Nyokap telpon suruh bayar kos. Duit gue tinggal {budget}, tapi {slot} jangan sampe norak ya!")
happy_lines = PackedStringArray("Gila Bang, motor gue jadi paling sangar! Respect!", "Mantap jiwa! Besok gue bawa anak-anak ke sini!")
neutral_lines = PackedStringArray("Hmm oke lah, lumayan Bang.", "Ya udah, cukup buat nongkrong.")
angry_lines = PackedStringArray("Apaan nih Bang?! Bunyinya aneh, catnya lecet! Gue viralin lu!", "Parah Bang, ini mah barang rongsok!")
