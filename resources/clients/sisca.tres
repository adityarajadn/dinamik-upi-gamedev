request_lines = PackedStringArray("Kak, aku mau ganti {parts} biar aman ke kampus. Tapi uangku cuma {budget} ya Kak...", "Permisi Kak, bisa pasang {parts}? Budget aku {budget}, itu udah sisa uang makan...")
twist_lines = PackedStringArray("Kak! Maaf banget, uang UKT-ku kurang! Sisa {budget}... tapi {slot}-nya pengen tetep lucu. Gimana Kak?", "Kak, transferan ortu belum masuk. Aku cuma ada {budget}. {slot} jangan jelek ya Kak...")
happy_lines = PackedStringArray("Makasih banyak Kak! Aku rekomendasiin ke temen-temen kampus!", "Yeay, motornya jadi gemes banget!")
neutral_lines = PackedStringArray("Oke Kak, makasih ya.", "Lumayan lah Kak, yang penting jalan.")
angry_lines = PackedStringArray("Kak, ini kok rusak sih?! Aku spill di medsos ya!", "Huhu, uangku habis buat barang jelek...")
