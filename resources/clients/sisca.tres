[resource]
script = ExtResource("1_s")
client_id = &"sisca"
client_name = "Sisca"
persona = "Broke college student"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(0.65, 0.6, 1, 1)
budget_tolerance_max = 0.05
request_lines = PackedStringArray("Hi, I want to replace the {parts} so it\'s safe for campus. But I only have {budget}...", "Excuse me, can you install {parts}? My budget is {budget}, that\'s what\'s left of my food money...")
twist_lines = PackedStringArray("So sorry! My tuition money fell short! Only {budget} left... but I still want the {slot} to be cute. What do we do?", "My parents\' transfer hasn\'t come in yet. I only have {budget}. Please don\'t make the {slot} ugly...")
happy_lines = PackedStringArray("Thank you so much! I\'ll recommend you to my campus friends!", "Yay, the bike looks so cute now!")
neutral_lines = PackedStringArray("Okay, thanks.", "Not bad, at least it runs.")
angry_lines = PackedStringArray("Why is this broken?! I\'m posting this on social media!", "Boohoo, I spent all my money on junk...")
