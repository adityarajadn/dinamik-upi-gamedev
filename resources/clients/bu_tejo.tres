[resource]
script = ExtResource("1_s")
client_id = &"bu_tejo"
client_name = "Bu Tejo"
persona = "Pushy savings-club boss"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(1, 0.62, 0.25, 1)
budget_tolerance_max = 0.1
request_lines = PackedStringArray("I\'m showing my bike off to the savings-club ladies. Replace the {parts}! Budget\'s {budget}, don\'t overcharge me!", "Hello mechanic! I want nice {parts}. I have {budget}, exactly that, not a cent more!")
twist_lines = PackedStringArray("Oh dear! The savings club just collected dues! I only have {budget} left, but the {slot} still has to look fancy, okay!", "Excuse me! My husband called and said to save money! I only have {budget}. But don\'t make the {slot} cheap!")
happy_lines = PackedStringArray("Oh how pretty! I\'ll promote you in my savings-club group!", "Lovely! The other ladies will be so jealous!")
neutral_lines = PackedStringArray("Oh well, it\'s decent.", "Hmm, it\'s just okay, but fine.")
angry_lines = PackedStringArray("Oh my goodness! What is this junk?! I\'m reporting you to the neighborhood chief!", "What is this?! That\'s not what we agreed on!")
