[resource]
script = ExtResource("1_s")
client_id = &"rizky"
client_name = "Rizky Joki"
persona = "Ambitious street racer"
texture_idle = ExtResource("t_idle")
texture_happy = ExtResource("t_happy")
texture_angry = ExtResource("t_angry")
texture_panic = ExtResource("t_panic")
scooter_tint = Color(0.95, 0.95, 0.2, 1)
request_lines = PackedStringArray("Bro, I\'ve got a street race tonight. Put on the fastest {parts}! Here\'s {budget}, let\'s go!", "Hurry up bro! I need {parts}. Budget\'s {budget}, don\'t be slow!")
twist_lines = PackedStringArray("Yo bro! I lost a bet! Only {budget} left, but the {slot} still has to look like a race bike! Figure something out!", "Sorry bro, I had to pay a traffic ticket. Only {budget} left. Don\'t let the {slot} look lame!")
happy_lines = PackedStringArray("Whoa, it flies! I\'m winning tonight!", "Sick, bro, you really are a wizard mechanic!")
neutral_lines = PackedStringArray("Alright, good enough to go a little fast.", "Not bad, not that ugly.")
angry_lines = PackedStringArray("This is slower than a pushcart! What a scam shop!", "You scammed me, bro?! Watch yourself!")
